<Project Sdk="Microsoft.NET.Sdk">

  <!-- The CLI: a thin host over the application, and the package the runners install. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lab</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfe.Lab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfe.Lab.Application\Wolfe.Lab.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ritten.CommandLine" />
    <PackageReference Include="Ritten.OnePassword" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Ritten.Commands" />
    <Using Include="Ritten.Contracts" />
    <Using Include="Ritten.Contracts.FileSystem" />
    <Using Include="Ritten.Engine" />
    <Using Include="Ritten.Engine.Workflows" />
    <Using Include="Ritten.Reporting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WriteLabSchema" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(CI)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; schema &quot;$(MSBuildThisFileDirectory)../../../schema/lab.schema.json&quot;" />
  </Target>

</Project>

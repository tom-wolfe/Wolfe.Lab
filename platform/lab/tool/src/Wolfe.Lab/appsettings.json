{
  // How the CLI behaves, as opposed to what a component is (its ritten.json).
  // Overridden per node by environment variables: LAB_Ollama__Serving__Limit.
  // Durations are TimeSpans: "hh:mm:ss".

  // Waits: ask again every Interval until the answer is yes; give up at Limit.
  // The vault's service account, for a node with no 1Password app to ask.
  "OnePassword": {
    "ServiceAccountTokenFile": "~/Docker/1password/service-account-token"
  },

  "Garage": {
    // A stack at bring-up has only just started.
    "Answering": { "Limit": "00:01:00", "Interval": "00:00:02" }
  },
  "Ollama": {
    // A cold start, with the model store on an external drive.
    "Serving": { "Limit": "00:00:30", "Interval": "00:00:01" }
  },
  "Launchd": {
    // For launchd to let go of a unit it was told to stop. Limit is for an agent
    // that sets no exit timeout (launchd's own 20s, and the margin); one that does
    // is given its exit timeout and the margin.
    "Unloading": { "Limit": "00:00:30", "Interval": "00:00:00.250", "Margin": "00:00:10" }
  },

  // HTTP: HttpStandardResilienceOptions — retries, per-attempt and overall timeouts,
  // and a breaker whose window must be at least twice an attempt.
  // Where the CLI reaches out to. Base addresses, so a self-hosted healthchecks
  // or a GitHub mirror is one line here.
  "Alerts": {
    "Endpoint": "https://api.pushover.net/1/messages.json"
  },
  "Heartbeat": {
    "Endpoint": "https://hc-ping.com/"
  },
  "Packages": {
    "Releases": "https://github.com/",
    "Api": "https://api.github.com/",
    // Releases run to hundreds of megabytes (ollama's).
    "Http": {
      "AttemptTimeout": { "Timeout": "00:05:00" },
      "TotalRequestTimeout": { "Timeout": "00:15:00" },
      "CircuitBreaker": { "SamplingDuration": "00:10:00" }
    }
  }
}

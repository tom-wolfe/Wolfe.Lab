# Generated by `lab deploy` — edits here are overwritten.
# program: {{ Program }}
# stamped: {{ Stamped }}
{{~ if InstallStamped }}
# installed: {{ InstallStamped }}
{{~ end }}

[Unit]
Description={{ Label }}
# KeepAlive means always: never give up restarting, as launchd does not.
StartLimitIntervalSec=0

[Service]
ExecStart={{ ExecStart }}
{{- if WorkingDirectory }}
WorkingDirectory={{ WorkingDirectory }}
{{- end }}
{{- for Variable in Environment }}
Environment={{ Variable.Value }}
{{- end }}
{{- if KeepAlive }}
Restart=always
RestartSec=10
{{- else }}
Restart=no
{{- end }}
{{- if ExitTimeout }}
TimeoutStopSec={{ ExitTimeout }}
{{- end }}
{{- if Log }}
StandardOutput=append:{{ Log }}
StandardError=append:{{ Log }}
{{- end }}

[Install]
WantedBy=default.target

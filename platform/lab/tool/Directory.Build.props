<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>Tom Wolfe</Authors>
    <Copyright>Copyright © 2026 Tom Wolfe</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The CLI's version is worked out, never typed: 1.0.<n>, where n counts the commits that
       changed what ships.  -->
  <Import Project="$(MSBuildThisFileDirectory)temp/version.props" Condition="Exists('$(MSBuildThisFileDirectory)temp/version.props')" />
  <PropertyGroup>
    <Version Condition="'$(LabVersion)' != ''">$(LabVersion)</Version>
    <Version Condition="'$(LabVersion)' == ''">1.0.0-local</Version>
  </PropertyGroup>

</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.twolfe.dev/schema",
  "title": "Wolfe.Lab declaration",
  "description": "A service or a component of the lab (ROADMAP.md #14). Name this schema in a file's first line to make it one of the lab's.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "description": "What the document declares: a service, or what a component is used for.",
      "enum": [
        "service",
        "app",
        "backend",
        "database",
        "cache",
        "queue",
        "storage",
        "proxy",
        "network",
        "model",
        "collector",
        "runner",
        "backup",
        "repository",
        "infrastructure",
        "certificate",
        "package",
        "machine"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "service"
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/service",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "service",
            "description": "A service: the unit the catalog lists, declared in its own directory."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The service's name, which is its directory's."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the service is, in a sentence."
          },
          "lifecycle": {
            "type": [
              "null",
              "string"
            ],
            "enum": [
              "production",
              "experimental",
              "deprecated",
              null
            ],
            "description": "Where the service is in its life; production unless it says otherwise."
          },
          "links": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the link is called on the page."
                },
                "type": {
                  "description": "What the link points at.",
                  "type": "string",
                  "enum": [
                    "app",
                    "runbook",
                    "docs",
                    "dashboard",
                    "repository"
                  ]
                },
                "url": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "An absolute URL. A link has a url or a path."
                },
                "path": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "A path relative to this file, for a file in the repository. A link has a url or a path."
                }
              },
              "required": [
                "title",
                "type"
              ],
              "additionalProperties": false
            },
            "description": "Where to use the service, read about it and watch it."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The services this one needs, by name."
          }
        },
        "required": [
          "kind",
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workflow"
        ],
        "properties": {
          "workflow": {
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "workflow"
        ],
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "enum": [
              "docker",
              "dotnet-service"
            ]
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/component/compose",
        "type": "object",
        "properties": {
          "kind": {
            "description": "What the component is used for: the icon it would have on a diagram.",
            "type": "string",
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "description": "The workflow that operates the component, whatever it is used for; it decides what else the document declares.",
            "type": "string",
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component's name within its service."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "What the component is, in a sentence."
          },
          "partOf": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component of this service this one lives inside: an app's SQLite database is part of the app."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The components of this service this one needs, by name."
          },
          "service": {
            "type": "string",
            "description": "The compose service the component runs as, as the compose file names it: the container keeps Docker's unique name, the component the catalog's."
          },
          "logs": {
            "type": [
              "null",
              "string"
            ],
            "enum": [
              "otlp",
              null
            ],
            "description": "How the component's logs reach the lab, when not as its output: otlp, when it sends its own."
          },
          "metrics": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "The port the service serves its metrics on, in its own container."
              },
              "path": {
                "type": [
                  "null",
                  "string"
                ],
                "description": "The path it serves them on: /metrics unless it says otherwise."
              }
            },
            "required": [
              "port"
            ],
            "additionalProperties": false,
            "description": "Where the component serves Prometheus metrics, in its own container."
          }
        },
        "required": [
          "kind",
          "workflow",
          "name",
          "service"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "workflow"
        ],
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "enum": [
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/component/common",
        "type": "object",
        "properties": {
          "kind": {
            "description": "What the component is used for: the icon it would have on a diagram.",
            "type": "string",
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "description": "The workflow that operates the component, whatever it is used for; it decides what else the document declares.",
            "type": "string",
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component's name within its service."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "What the component is, in a sentence."
          },
          "partOf": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component of this service this one lives inside: an app's SQLite database is part of the app."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The components of this service this one needs, by name."
          }
        },
        "required": [
          "kind",
          "workflow",
          "name"
        ],
        "additionalProperties": false
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.twolfe.dev/schema",
  "title": "Wolfe.Lab declaration",
  "description": "A service, a component or a node of the lab (ROADMAP.md #14). Name this schema in a file's first line to make it one of the lab's.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "description": "What the document declares: a service, a node, or what a component is used for.",
      "enum": [
        "service",
        "node",
        "app",
        "backend",
        "database",
        "cache",
        "queue",
        "storage",
        "proxy",
        "network",
        "model",
        "collector",
        "runner",
        "backup",
        "repository",
        "infrastructure",
        "certificate",
        "package",
        "machine"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "service"
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/service",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "service",
            "description": "A service: the unit the catalog lists, declared in its own directory."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The service's name, which is its directory's."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the service is, in a sentence."
          },
          "lifecycle": {
            "type": [
              "null",
              "string"
            ],
            "enum": [
              "production",
              "experimental",
              "deprecated",
              null
            ],
            "description": "Where the service is in its life; production unless it says otherwise."
          },
          "links": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the link is called on the page."
                },
                "type": {
                  "description": "What the link points at.",
                  "type": "string",
                  "enum": [
                    "app",
                    "runbook",
                    "docs",
                    "dashboard",
                    "repository"
                  ]
                },
                "url": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "An absolute URL. A link has a url or a path."
                },
                "path": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "A path relative to this file, for a file in the repository. A link has a url or a path."
                }
              },
              "required": [
                "title",
                "type"
              ],
              "additionalProperties": false
            },
            "description": "Where to use the service, read about it and watch it."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The services this one needs, by name."
          }
        },
        "required": [
          "kind",
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "node"
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/node",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "node",
            "description": "A node: a machine the lab runs on, declared in platform/."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The node's name: what a component's runsOn names it by."
          },
          "role": {
            "description": "What the node is to the lab: what fails when it does.",
            "type": "string",
            "enum": [
              "server",
              "hybrid"
            ]
          },
          "platform": {
            "description": "The node's operating system and architecture, as release assets name them.",
            "type": "string",
            "enum": [
              "darwin-arm64",
              "linux-arm64",
              "linux-amd64"
            ]
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "Where the other nodes reach it: its name on the tailnet."
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "description": "Where it installs components and their artifacts, written whole: {lab.root}, and LAB_ROOT on the node."
          },
          "data": {
            "type": "string",
            "minLength": 1,
            "description": "Where its services keep their state, written whole: {lab.data}, and LAB_DATA on the node."
          },
          "docker": {
            "type": [
              "null",
              "string"
            ],
            "minLength": 1,
            "description": "Where its Docker socket is, when it runs Docker: {node.docker}."
          },
          "drives": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "The external drives it holds, where it mounts them: {node.drives}, comma-separated."
          }
        },
        "required": [
          "kind",
          "name",
          "role",
          "platform",
          "address",
          "root",
          "data"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workflow"
        ],
        "properties": {
          "workflow": {
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "workflow"
        ],
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "enum": [
              "docker",
              "dotnet-service"
            ]
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/component/compose",
        "type": "object",
        "properties": {
          "kind": {
            "description": "What the component is used for: the icon it would have on a diagram.",
            "type": "string",
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "description": "The workflow that operates the component, whatever it is used for; it decides what else the document declares.",
            "type": "string",
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component's name within its service."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "What the component is, in a sentence."
          },
          "partOf": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component of this service this one lives inside: an app's SQLite database is part of the app."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The components of this service this one needs, by name."
          },
          "service": {
            "type": "string",
            "description": "The compose service the component runs as, as the compose file names it: the container keeps Docker's unique name, the component the catalog's."
          },
          "logs": {
            "type": [
              "null",
              "string"
            ],
            "enum": [
              "otlp",
              null
            ],
            "description": "How the component's logs reach the lab, when not as its output: otlp, when it sends its own."
          },
          "metrics": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "The port the service serves its metrics on, in its own container."
              },
              "path": {
                "type": [
                  "null",
                  "string"
                ],
                "description": "The path it serves them on: /metrics unless it says otherwise."
              }
            },
            "required": [
              "port"
            ],
            "additionalProperties": false,
            "description": "Where the component serves Prometheus metrics, in its own container."
          }
        },
        "required": [
          "kind",
          "workflow",
          "name",
          "service"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "workflow"
        ],
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "enum": [
              "agents",
              "ollama"
            ]
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/component/agents",
        "type": "object",
        "properties": {
          "kind": {
            "description": "What the component is used for: the icon it would have on a diagram.",
            "type": "string",
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "description": "The workflow that operates the component, whatever it is used for; it decides what else the document declares.",
            "type": "string",
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component's name within its service."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "What the component is, in a sentence."
          },
          "partOf": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component of this service this one lives inside: an app's SQLite database is part of the app."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The components of this service this one needs, by name."
          },
          "runsOn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(all|every [a-z]+)$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ],
            "description": "The nodes it runs on: 'all', 'every <role>', or a list of nodes by name."
          },
          "agent": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The name it runs under on each node — its unit is dev.twolfe.<agent> — and the service_name its logs carry."
          },
          "package": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "github": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                "description": "The GitHub repository it is released from: owner/name."
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "description": "The version, pinned: {version} in the asset and checksums."
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "description": "The release's asset to install, named for the node by {platform}, or {platform.os} and {platform.arch}."
              },
              "checksums": {
                "type": [
                  "null",
                  "string"
                ],
                "minLength": 1,
                "description": "The release's checksum file; without one, GitHub's own digest of the asset."
              }
            },
            "required": [
              "github",
              "version",
              "asset"
            ],
            "additionalProperties": false,
            "description": "What it runs, installed from a GitHub release."
          },
          "program": {
            "type": [
              "null",
              "string"
            ],
            "minLength": 1,
            "description": "The executable: {package}/<file> for one its package holds."
          },
          "arguments": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "The arguments it runs with."
          },
          "environment": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string",
              "description": "The variables it runs with; what the node sets for every agent is not declared."
            },
            "description": "The variables it runs with; what the node sets for every agent is not declared."
          },
          "supersedes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Units an earlier supervisor ran it under, retired before it starts."
          },
          "declaresAgent": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "required": [
          "kind",
          "workflow",
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "required": [
          "kind",
          "workflow"
        ],
        "properties": {
          "kind": {
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "enum": [
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          }
        }
      },
      "then": {
        "$id": "https://lab.twolfe.dev/schema/component/common",
        "type": "object",
        "properties": {
          "kind": {
            "description": "What the component is used for: the icon it would have on a diagram.",
            "type": "string",
            "enum": [
              "app",
              "backend",
              "database",
              "cache",
              "queue",
              "storage",
              "proxy",
              "network",
              "model",
              "collector",
              "runner",
              "backup",
              "repository",
              "infrastructure",
              "certificate",
              "package",
              "machine"
            ]
          },
          "workflow": {
            "description": "The workflow that operates the component, whatever it is used for; it decides what else the document declares.",
            "type": "string",
            "enum": [
              "docker",
              "dotnet-service",
              "agents",
              "ollama",
              "forgejo-runners",
              "obsidian",
              "restic",
              "tofu",
              "caddy-certificates",
              "image",
              "dotnet-tool",
              "chezmoi"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component's name within its service."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name people read, when the name is not it."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "What the component is, in a sentence."
          },
          "partOf": {
            "type": [
              "null",
              "string"
            ],
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The component of this service this one lives inside: an app's SQLite database is part of the app."
          },
          "dependsOn": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true,
            "description": "The components of this service this one needs, by name."
          }
        },
        "required": [
          "kind",
          "workflow",
          "name"
        ],
        "additionalProperties": false
      }
    }
  ]
}

{{- /* The HOST runner: one job at a time (deploys mutate node state; a job
       that overlaps itself queues). */ -}}
{{- /* The lab's two roots (platform/lab/README.md, "Two roots"): where components and
       their artifacts are installed, and where services keep their state — and
       LAB_NODE, which node this is. All three are the node's declaration in
       platform/nodes.yaml, which the zprofile exports too, so a job and a shell agree. */ -}}
{{- $lab := includeTemplate "lab-node.tmpl" . | fromJson -}}
{{- $root := $lab.root -}}
{{- $data := $lab.data -}}
{{- $name := $lab.name -}}
{{- $node := (index .profiles .profile).node -}}
{{- if eq .profile "macmini-node" -}}
{{- /* Capacity 3: stateful jobs serialise themselves through the MacMini
       concurrency group; the heartbeat, the obsidian syncs and the Gatus
       probe must never queue behind a six-hour restic copy. */ -}}
{{- template "forgejo-runner/config.yaml" (dict
      "home" .chezmoi.homeDir
      "dir" "forgejo-runner"
      "capacity" 3
      "host" true
      "labels" (list (printf "%s:host" $node))
      "cache" false
      "path" (printf "%s/.local/share/forgejo-runner/bin:%s/.docker-headless/bin:%s/.dotnet/tools:/usr/local/share/dotnet:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" .chezmoi.homeDir .chezmoi.homeDir .chezmoi.homeDir)
      "envs" (dict
        "LAB_ROOT" $root
        "LAB_DATA" $data
        "LAB_NODE" $name
        "DOCKER_CONFIG" (printf "%s/.docker-headless" .chezmoi.homeDir)
        "TF_PLUGIN_CACHE_DIR" (printf "%s/.cache/tofu-plugins" .chezmoi.homeDir))) -}}
{{- end -}}
{{- if eq .profile "macstudio" -}}
{{- template "forgejo-runner/config.yaml" (dict
      "home" .chezmoi.homeDir
      "dir" "forgejo-runner"
      "capacity" 3
      "host" true
      "labels" (list (printf "%s:host" $node))
      "cache" false
      "path" (printf "%s/.local/share/forgejo-runner/bin:%s/.dotnet/tools:/usr/local/share/dotnet:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" .chezmoi.homeDir .chezmoi.homeDir)
      "envs" (dict "LAB_ROOT" $root "LAB_DATA" $data "LAB_NODE" $name)) -}}
{{- end -}}
{{- if eq .profile "pi-node" -}}
{{- /* /usr/sbin: where Debian puts logrotate, which the lab runs to rotate its agents' logs.
       DOTNET_ROOT: the SDK is a tarball in ~/.dotnet, and a global tool's
       launcher (`lab`) finds the runtime there or in a system location —
       never through PATH. */ -}}
{{- template "forgejo-runner/config.yaml" (dict
      "home" .chezmoi.homeDir
      "dir" "forgejo-runner"
      "capacity" 1
      "host" true
      "labels" (list (printf "%s:host" $node))
      "cache" false
      "path" (printf "%s/.local/bin:%s/.dotnet:%s/.dotnet/tools:/usr/local/bin:/usr/bin:/bin:/usr/sbin" .chezmoi.homeDir .chezmoi.homeDir .chezmoi.homeDir)
      "envs" (dict
        "LAB_ROOT" $root
        "LAB_DATA" $data
        "LAB_NODE" $name
        "DOTNET_ROOT" (printf "%s/.dotnet" .chezmoi.homeDir))) -}}
{{- end -}}

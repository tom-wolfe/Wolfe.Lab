{{ if eq .profile "pi-node" -}}
#!/bin/bash
# The .NET SDK on the Pi. The lab's jobs ARE the CLI, and this node runs
# them like every other — `lab deploy` for gatus, and whatever follows.
#
# Not a chezmoi external: those are single pinned binaries under
# ~/.local/bin, and this is a 200 MB tree.
set -euo pipefail

version="{{ (include (joinPath .chezmoi.workingTree "platform/lab/tool/global.json") | fromJson).sdk.version }}"
root="$HOME/.dotnet"

# Side-by-side by design: the tarball extracts into sdk/<version>, so an
# upgrade adds rather than replaces and a rollback is a re-run of the old
# value. Nothing to do when this exact SDK is already there.
[ -d "$root/sdk/$version" ] && exit 0

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

url="https://builds.dotnet.microsoft.com/dotnet/Sdk/$version/dotnet-sdk-$version-linux-arm64.tar.gz"
curl -fsSL "$url" -o "$tmp/sdk.tar.gz"
curl -fsSL "$url.sha512" | awk '{ print $1 }' > "$tmp/sdk.sha512"
echo "$(cat "$tmp/sdk.sha512")  $tmp/sdk.tar.gz" | sha512sum -c - >/dev/null

mkdir -p "$root"
tar -xzf "$tmp/sdk.tar.gz" -C "$root"
{{ end -}}

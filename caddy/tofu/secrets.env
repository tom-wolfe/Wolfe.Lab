# 1Password secret references — safe to commit, resolved at spawn by:
#   op run --env-file=secrets.env -- tofu <cmd>

# State backend (Garage)
AWS_ACCESS_KEY_ID="op://Wolfe.Lab/garage-tofu-state-key/username"
AWS_SECRET_ACCESS_KEY="op://Wolfe.Lab/garage-tofu-state-key/credential"

# State encryption passphrase — see encryption.tf. Create as a Password
# item named exactly `tofu-state-passphrase` in the Wolfe.Lab vault.
TF_VAR_state_passphrase="op://Wolfe.Lab/tofu-state-passphrase/password"

# Netlify PAT (account-wide). If op errors on the field name, check the
# item's category: API Credential items expose `credential`, Password
# items expose `password`.
TF_VAR_netlify_token="op://Wolfe.Lab/netlify-pat/credential"

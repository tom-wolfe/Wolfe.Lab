# 1Password secret references — safe to commit, resolved at spawn by:
#   op run --env-file=secrets.env -- tofu <cmd>
# 'Kestra Admin' is vaulted during the compose/kestra bootstrap (see its README).

# State backend (Garage)
AWS_ACCESS_KEY_ID="op://Personal/Garage tofu-state-key/username"
AWS_SECRET_ACCESS_KEY="op://Personal/Garage tofu-state-key/credential"

# Kestra basic auth
TF_VAR_kestra_username="op://Personal/Kestra Admin/username"
TF_VAR_kestra_password="op://Personal/Kestra Admin/credential"

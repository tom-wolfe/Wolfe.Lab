# 1Password secret references — safe to commit, resolved at spawn by:
#   op run --env-file=secrets.env -- tofu <cmd>

AWS_ACCESS_KEY_ID="op://Wolfe.Lab/garage-tofu-state-key/username"
AWS_SECRET_ACCESS_KEY="op://Wolfe.Lab/garage-tofu-state-key/credential"
TF_VAR_state_passphrase="op://Wolfe.Lab/tofu-state-passphrase/password"

# Tailscale OAuth client (admin console -> Settings -> Trust credentials):
# scopes policy_file, devices:core and dns, write; tag:server. An API
# Credential item named `tailscale-oauth`: `username` = client id,
# `credential` = client secret. RUNBOOK.md "The root".
TF_VAR_tailscale_oauth_client_id="op://Wolfe.Lab/tailscale-oauth/username"
TF_VAR_tailscale_oauth_client_secret="op://Wolfe.Lab/tailscale-oauth/credential"

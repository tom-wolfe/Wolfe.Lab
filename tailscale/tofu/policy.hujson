// The lab's tailnet policy. Managed by tailscale/tofu (policy.tf).
//
// One tag. A tagged device belongs to its tag rather than to a user, which
// is what an always-on node is: nobody is logged in to vouch for it, and
// its key must not expire. Workstations stay user-owned on purpose —
// tagging one would strip its user identity and its interactive re-auth —
// so "my devices" is autogroup:member, not a second tag.
{
  "tagOwners": {
    "tag:server": ["autogroup:admin"],
  },

  "acls": [
    // My devices reach every server, on any port.
    {"action": "accept", "src": ["autogroup:member"], "dst": ["tag:server:*"]},

    // Servers reach each other: the Pi's Beszel agent dials the hub, Gatus
    // on the Pi probes the mini, caddy on the mini proxies to the Pi, the
    // Pi clones from the forgejo sidecar and backs up to the mini over SFTP.
    {"action": "accept", "src": ["tag:server"], "dst": ["tag:server:*"]},

    // Nothing reaches a workstation — not a server, not another workstation.
  ],
}

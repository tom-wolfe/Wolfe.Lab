# 1Password secret references — safe to commit, resolved at spawn by:
#   op run --env-file=secrets.env -- tofu <cmd>

AWS_ACCESS_KEY_ID="op://Wolfe.Lab/garage-tofu-state-key/username"
AWS_SECRET_ACCESS_KEY="op://Wolfe.Lab/garage-tofu-state-key/credential"
TF_VAR_state_passphrase="op://Wolfe.Lab/tofu-state-passphrase/password"

# B2 MASTER application key — Account -> Application Keys in the B2 UI.
# Create as an API Credential item named exactly `b2-master-key` in the
# Wolfe.Lab vault: `username` = keyID, `credential` = applicationKey.
# Used only by this root; restic gets the scoped key main.tf mints.
TF_VAR_b2_application_key_id="op://Wolfe.Lab/b2-master-key/username"
TF_VAR_b2_application_key="op://Wolfe.Lab/b2-master-key/credential"

TF_VAR_healthchecks_api_key="op://Wolfe.Lab/healthchecks-api-key/credential"

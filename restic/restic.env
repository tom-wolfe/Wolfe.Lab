# The lab's restic repository on the backups drive — every backup script
# resolves this at spawn:
#   op run --env-file=restic/restic.env -- restic <cmd>
# The op:// reference is safe to commit; the vault is the origin (create
# the `restic-repo` Password item before first use — see README.md).
RESTIC_REPOSITORY=/Volumes/Data2/restic
RESTIC_PASSWORD="op://Wolfe.Lab/restic-repo/password"

{
  "workflow": "backup",
  "release": "sonarr",
  "volumes": [
    "/Volumes/Data1",
    "/Volumes/Data2"
  ],
  "paths": [
    "~/Docker/sonarr/config"
  ],
  "excludes": [
    "~/Docker/sonarr/config/Backups",
    "~/Docker/sonarr/config/MediaCover",
    "~/Docker/sonarr/config/logs",
    "~/Docker/sonarr/config/logs.db",
    "~/Docker/sonarr/config/logs.db-*"
  ],
  "stop": "sonarr",
  "verify": [
    "~/Docker/sonarr/config/sonarr.db"
  ]
}

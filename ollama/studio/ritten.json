{
  "workflow": "ollama",
  "models": {
    "store": "~/.ollama/models",
    "pull": [
      "qwen3:8b",
      "qwen3:30b-a3b",
      "embeddinggemma:300m"
    ],
    "roles": {
      "background": { "model": "qwen3:30b-a3b" },
      "interactive": { "model": "qwen3:30b-a3b" },
      "embedding": { "model": "embeddinggemma:300m", "identical": true }
    }
  },
  "agents": {
    "ollama": {
      "program": "/opt/homebrew/bin/ollama",
      "arguments": ["serve"],
      "environment": {
        "OLLAMA_HOST": "0.0.0.0:11434",
        "OLLAMA_MODELS": "/Users/tomwolfe/.ollama/models",
        "OLLAMA_NUM_PARALLEL": "1"
      },
      "log": "~/Library/Logs/ollama.log"
    }
  }
}

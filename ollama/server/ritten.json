{
  "workflow": "ollama",
  "volumes": [
    "/Volumes/Data2"
  ],
  "models": {
    "store": "/Volumes/Data2/ollama/models",
    "pull": [
      "qwen3:8b",
      "embeddinggemma:300m"
    ],
    "roles": {
      "background": { "model": "qwen3:8b" },
      "interactive": { "model": "qwen3:8b" },
      "embedding": { "model": "embeddinggemma:300m", "identical": true }
    }
  },
  "agents": {
    "ollama": {
      "package": {
        "github": "ollama/ollama",
        "version": "0.34.4",
        "asset": "ollama-darwin.tgz",
        "checksums": "sha256sum.txt"
      },
      "program": "${PACKAGE}/ollama",
      "arguments": ["serve"],
      "environment": {
        "OLLAMA_HOST": "0.0.0.0:11434",
        "OLLAMA_MODELS": "/Volumes/Data2/ollama/models"
      },
      "log": "~/Library/Logs/ollama.log"
    }
  }
}

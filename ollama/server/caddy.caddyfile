# This slice's route through the front door — see forgejo/caddy.caddyfile
# for the shape's rationale.
#
# The NAME IS THE CAPABILITY, not the implementation. `ai` rather than
# `ollama` because the upstream behind it is expected to change — the
# Studio joins it, and the runtime itself may be swapped — and nothing
# that consumes it should have to care which.
#
# Everything behind this door is tailnet-only now, which is the whole of
# what this route can do for an endpoint with no authentication of any
# kind. It does nothing about the port itself — see README.md.
@ai host ai.twolfe.dev
handle @ai {
	# host.docker.internal, because ollama is a HOST process rather than a
	# container: a container on macOS gets no access to the Apple GPU, so
	# the model server is the one thing in the lab that cannot sit on the
	# `lab` network. This is the only route in the lab that leaves it.
	#
	# The Studio first, the mini behind it: lb_policy first sends every
	# request to the Studio while its health check passes, and to the mini
	# the moment it doesn't — the Studio asleep is a failed check within ten
	# seconds, and a request that lands in that window is retried on the mini
	# (lb_try_duration). Nothing that calls this notices either way:
	# ROADMAP #7's rule, the Studio may serve but nothing may depend on it.
	# That only holds while the Studio holds every model the mini does — see
	# ollama/README.md "The Studio".
	#
	# The Studio by its MagicDNS name, over the tailnet: tag:server may reach
	# tag:hybrid on 11434 and nothing else (tailscale/tofu/policy.hujson).
	#
	reverse_proxy macstudio.tailf823b8.ts.net:11434 host.docker.internal:11434 {
		header_up Host {upstream_hostport}
		header_up -Origin

		lb_policy first
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /api/tags
		health_interval 10s
	}
}

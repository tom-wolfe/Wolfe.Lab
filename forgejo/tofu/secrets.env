# 1Password secret references — safe to commit, resolved at spawn by:
#   op run --env-file=secrets.env -- tofu <cmd>
# Create the four GitHub PAT items with exactly these titles (see README).

# State backend (Garage)
AWS_ACCESS_KEY_ID="op://Wolfe.Lab/garage-tofu-state-key/username"
AWS_SECRET_ACCESS_KEY="op://Wolfe.Lab/garage-tofu-state-key/credential"

# Forgejo API (both providers read this)
FORGEJO_API_TOKEN="op://Wolfe.Lab/forgejo-api-token/credential"

# Fine-grained PATs, one per owner with private repos
TF_VAR_github_token_tom_wolfe="op://Wolfe.Lab/github-tom-wolfe-pat/credential"
TF_VAR_github_token_nschema_org="op://Wolfe.Lab/github-nschema-org-pat/credential"
TF_VAR_github_token_disastercare="op://Wolfe.Lab/github-disastercare-pat/credential"

# State encryption passphrase — see encryption.tf
TF_VAR_state_passphrase="op://Wolfe.Lab/tofu-state-passphrase/password"

# Netlify PAT (account-wide) — the git.twolfe.dev record in records.tf
TF_VAR_netlify_token="op://Wolfe.Lab/netlify-pat/credential"

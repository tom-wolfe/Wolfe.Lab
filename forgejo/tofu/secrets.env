# 1Password secret references — safe to commit, resolved at spawn by:
#   op run --env-file=secrets.env -- tofu <cmd>
# Create the four GitHub PAT items with exactly these titles (see README).

# State backend (Garage)
AWS_ACCESS_KEY_ID="op://Wolfe.Lab/Garage tofu-state-key/username"
AWS_SECRET_ACCESS_KEY="op://Wolfe.Lab/Garage tofu-state-key/credential"

# Forgejo API (both providers read this)
FORGEJO_API_TOKEN="op://Wolfe.Lab/Forgejo API Token/credential"

# Fine-grained PATs, one per owner with private repos
TF_VAR_github_token_tom_wolfe="op://Wolfe.Lab/GitHub PAT tom-wolfe/credential"
TF_VAR_github_token_nschema_org="op://Wolfe.Lab/GitHub PAT nschema-org/credential"
TF_VAR_github_token_disastercare="op://Wolfe.Lab/GitHub PAT DisasterCare/credential"

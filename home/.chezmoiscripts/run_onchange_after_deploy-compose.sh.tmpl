{{ if eq .machine "server" -}}
#!/bin/bash

# Converge docker compose stacks when their files change:
{{ range glob (joinPath .chezmoi.workingTree "compose/*/compose.yaml") -}}
# {{ base (dir .) }}: {{ include . | sha256sum }}
{{ end -}}
set -uo pipefail

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Set by chezmoi for scripts; fall back for manual runs
CHEZMOI_WORKING_TREE="${CHEZMOI_WORKING_TREE:-$(chezmoi source-path)/..}"

failed=0
for stack_dir in "$CHEZMOI_WORKING_TREE"/compose/*/; do
  [ -f "$stack_dir/compose.yaml" ] || continue
  stack=$(basename "$stack_dir")
  echo "converging stack: $stack"
  if ! docker compose --project-directory "$stack_dir" up -d --remove-orphans; then
    echo "ERROR: stack $stack failed to converge" >&2
    failed=1
  fi
done
exit $failed
{{ end -}}

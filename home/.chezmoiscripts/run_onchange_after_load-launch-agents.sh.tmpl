{{ if eq .machine "server" -}}
#!/bin/bash
# Reload the launch agents managed in this repo when their plists change:
{{ range glob (joinPath .chezmoi.sourceDir "private_Library/private_LaunchAgents/*.plist") -}}
# {{ base . }}: {{ include . | sha256sum }}
{{ end -}}
set -uo pipefail

uid=$(id -u)
failed=0

# Only our own agents — third-party agents in the same folder are left alone.
# Assumes each plist's filename matches its Label (true for ours).
agents=()
{{ range glob (joinPath .chezmoi.sourceDir "private_Library/private_LaunchAgents/*.plist") -}}
agents+=("{{ base . }}")
{{ end -}}

for name in "${agents[@]}"; do
  plist="$HOME/Library/LaunchAgents/$name"
  label="${name%.plist}"
  echo "reloading $label"

  if launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
    launchctl bootout "gui/$uid/$label"
    # bootout only *starts* teardown; wait for it to finish (max ~10s)
    for _ in $(seq 1 20); do
      launchctl print "gui/$uid/$label" >/dev/null 2>&1 || break
      sleep 0.5
    done
  fi

  if ! launchctl bootstrap "gui/$uid" "$plist"; then
    echo "ERROR: bootstrap failed for $label" >&2
    failed=1
  fi
done

exit $failed
{{ end -}}

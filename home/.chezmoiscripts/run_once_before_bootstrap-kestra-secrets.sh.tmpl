{{ if eq .machine "server" -}}
#!/bin/bash
# Materialize Kestra's runtime secrets from 1Password. The vault is the
# origin: wipe ~/Docker/kestra, re-run, and the SAME secrets come back —
# recreating infrastructure never changes a password (Forgejo issue #1).
# The env files are a cache, never the source.
#
# Needs `op` signed in, so run from the GUI session (Screen Sharing) —
# only on first bootstrap or after a wipe; the guards make every other
# run a no-op. The four items are listed in compose/kestra/README.md.

set -euo pipefail

kdir="$HOME/Docker/kestra"
mkdir -p "$kdir/storage" "$kdir/postgres" "$kdir/ssh"

if [ ! -f "$kdir/ssh/id_ed25519" ]; then
  echo "materializing kestra job-bridge ssh key from 1Password"
  umask 077
  op read "op://Personal/Kestra Job Bridge/private key?ssh-format=openssh" > "$kdir/ssh/id_ed25519"
  op read "op://Personal/Kestra Job Bridge/public key" > "$kdir/ssh/id_ed25519.pub"
  echo "NOTE: run 'chezmoi apply' once more — authorized_keys rendered" \
       "before this key existed; the second pass templates it in."
fi

if [ ! -f "$kdir/kestra.env" ]; then
  echo "materializing kestra env files from 1Password"
  umask 077
  db_password=$(op read "op://Personal/Kestra Postgres/credential")
  printf 'POSTGRES_PASSWORD=%s\n' "$db_password" > "$kdir/postgres.env"
  {
    printf 'KESTRA_DB_PASSWORD=%s\n' "$db_password"
    printf 'KESTRA_BASIC_AUTH_PASSWORD=%s\n' "$(op read "op://Personal/Kestra Admin/credential")"
    # Exactly 32 chars — kestra.encryption.secret-key requires it.
    printf 'KESTRA_ENCRYPTION_KEY=%s\n' "$(op read "op://Personal/Kestra Encryption Key/credential")"
    # OSS secrets convention: SECRET_<NAME>, base64-encoded, read in flows
    # as {{ "{{ secret('LAB_SSH_KEY') }}" }}.
    printf 'SECRET_LAB_SSH_KEY=%s\n' "$(base64 -i "$kdir/ssh/id_ed25519" | tr -d '\n')"
  } > "$kdir/kestra.env"
fi

# Docker config without the osxkeychain credsStore: SSH sessions have no
# login keychain, which breaks even anonymous pulls of public images.
# lab-job points DOCKER_CONFIG here.
if [ ! -f "$HOME/.docker-headless/config.json" ]; then
  mkdir -p "$HOME/.docker-headless"
  printf '{}\n' > "$HOME/.docker-headless/config.json"
fi
{{ end -}}

{{ if eq .machine "server" -}}
#!/bin/bash
# Materialize Kestra's runtime secrets from 1Password. The vault is the
# origin: wipe ~/Docker/kestra, re-run, and the SAME secrets come back —
# recreating infrastructure never changes a password (Forgejo issue #1).
# The env files are a cache, never the source.
#
# Needs `op` signed in, so run from the GUI session (Screen Sharing) —
# only on first bootstrap or after a wipe; the guards make every other
# run a no-op. The four items are listed in compose/kestra/README.md.
#
# Structure matters here: EVERY op read happens into a variable, as an
# assignment, before ANY file is written. A `>` redirect creates its target
# before the command runs, so `op read > file` that fails leaves an empty
# husk behind — which then satisfies a file-exists guard and poisons every
# later run. Assignments abort cleanly under set -e with nothing on disk.
# Guards use -s (non-empty), so a husk could never wedge us again anyway.

set -euo pipefail

# Prefer the machine's 1Password service account when present — headless-safe
# (works over SSH, no app session) and scoped to the Wolfe.Lab vault. Falls
# back to the desktop-app integration otherwise. See README "Manual sign-ins".
token_file="$HOME/Docker/1password/service-account-token"
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -s "$token_file" ]; then
  OP_SERVICE_ACCOUNT_TOKEN=$(cat "$token_file")
  export OP_SERVICE_ACCOUNT_TOKEN
fi

kdir="$HOME/Docker/kestra"
mkdir -p "$kdir/storage" "$kdir/postgres" "$kdir/ssh"

if [ ! -s "$kdir/ssh/id_ed25519" ] || [ ! -s "$kdir/kestra.env" ]; then
  echo "materializing kestra secrets from 1Password"

  # --- read everything first; any failure aborts with no files touched ---
  ssh_private_key=$(op read "op://Wolfe.Lab/Kestra Job Bridge/private key?ssh-format=openssh")
  ssh_public_key=$(op read "op://Wolfe.Lab/Kestra Job Bridge/public key")
  db_password=$(op read "op://Wolfe.Lab/Kestra Postgres/password")
  admin_password=$(op read "op://Wolfe.Lab/Kestra Admin/password")
  # Exactly 32 chars — kestra.encryption.secret-key requires it.
  encryption_key=$(op read "op://Wolfe.Lab/Kestra Encryption Key/credential")

  # --- only now write, all from variables ---
  umask 077
  printf '%s\n' "$ssh_private_key" > "$kdir/ssh/id_ed25519"
  printf '%s\n' "$ssh_public_key" > "$kdir/ssh/id_ed25519.pub"

  printf 'POSTGRES_PASSWORD=%s\n' "$db_password" > "$kdir/postgres.env"
  {
    printf 'KESTRA_DB_PASSWORD=%s\n' "$db_password"
    printf 'KESTRA_BASIC_AUTH_PASSWORD=%s\n' "$admin_password"
    printf 'KESTRA_ENCRYPTION_KEY=%s\n' "$encryption_key"
    # OSS secrets convention: SECRET_<NAME>, base64-encoded, read in flows
    # as {{ "{{ secret('LAB_SSH_KEY') }}" }}.
    printf 'SECRET_LAB_SSH_KEY=%s\n' "$(printf '%s\n' "$ssh_private_key" | base64 | tr -d '\n')"
  } > "$kdir/kestra.env"

  echo "NOTE: run 'chezmoi apply' once more if ~/.ssh/authorized_keys" \
       "doesn't yet contain the kestra-job-bridge line."
fi

# Docker config without the osxkeychain credsStore: SSH sessions have no
# login keychain, which breaks even anonymous pulls of public images.
# lab-job points DOCKER_CONFIG here.
if [ ! -f "$HOME/.docker-headless/config.json" ]; then
  mkdir -p "$HOME/.docker-headless"
  printf '{}\n' > "$HOME/.docker-headless/config.json"
fi
{{ end -}}

{{ if eq .machine "server" -}}
#!/bin/bash
# Garage's runtime secrets: generated on this machine, never in the repo,
# never displayed. compose/garage/compose.yaml reads them via env_file.

set -euo pipefail

garage_dir="$HOME/Docker/garage"
mkdir -p "$garage_dir/meta" "$garage_dir/data"

if [ ! -f "$garage_dir/garage.env" ]; then
  echo "generating garage secrets"
  umask 077
  printf 'GARAGE_RPC_SECRET=%s\nGARAGE_ADMIN_TOKEN=%s\n' \
    "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" > "$garage_dir/garage.env"
fi
{{ end -}}

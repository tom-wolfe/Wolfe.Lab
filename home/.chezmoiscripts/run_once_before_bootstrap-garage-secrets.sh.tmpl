{{ if eq .machine "server" -}}
#!/bin/bash
# Materialize Garage's runtime secrets from 1Password — the vault is the
# origin, this env file is a cache (see the kestra bootstrap for the
# pattern). compose/garage/compose.yaml reads it via env_file.
#
# Needs `op` signed in (GUI session); no-op while the file exists.
# Items: 'Garage RPC Secret' and 'Garage S3 Admin Token' (Personal vault).

set -euo pipefail

# Prefer the machine's 1Password service account when present (headless-safe,
# scoped to the Wolfe.Lab vault); desktop-app integration otherwise.
token_file="$HOME/Docker/1password/service-account-token"
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -s "$token_file" ]; then
  OP_SERVICE_ACCOUNT_TOKEN=$(cat "$token_file")
  export OP_SERVICE_ACCOUNT_TOKEN
fi

garage_dir="$HOME/Docker/garage"
mkdir -p "$garage_dir/meta" "$garage_dir/data"

if [ ! -f "$garage_dir/garage.env" ]; then
  echo "materializing garage secrets from 1Password"
  umask 077
  printf 'GARAGE_RPC_SECRET=%s\nGARAGE_ADMIN_TOKEN=%s\n' \
    "$(op read 'op://Wolfe.Lab/Garage RPC Secret/credential')" \
    "$(op read 'op://Wolfe.Lab/Garage S3 Admin Token/credential')" > "$garage_dir/garage.env"
fi
{{ end -}}

{{ if eq .profile "macmini-node" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
The node's Actions runner, as a launchd agent. The macOS version of 
dot_config/systemd/user/forgejo-runner.service.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.twolfe.forgejo-runner</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/forgejo-runner/bin/forgejo-runner</string>
		<string>daemon</string>
		<string>--config</string>
		<string>{{ .chezmoi.homeDir }}/.config/forgejo-runner/config.yaml</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{ .chezmoi.homeDir }}/.config/forgejo-runner</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>600</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/forgejo-runner.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/forgejo-runner.log</string>
</dict>
</plist>
{{ end -}}

# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:/Users/tomwolfe/.docker/bin"
# End of Docker Desktop section.

{{ if has .profile (list "macbook" "macstudio" "work-macbook") -}}
eval "$(/opt/homebrew/bin/brew shellenv)"

# .NET SDK tools
export PATH="$PATH:$HOME/.dotnet/tools"

# Added by Toolbox App
export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
{{ end -}}

{{ if eq .profile "macmini-node" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"

# .NET SDK tools
export PATH="$PATH:$HOME/.dotnet/tools"

# 1Password service account.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -s "$HOME/Docker/1password/service-account-token" ]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$HOME/Docker/1password/service-account-token")"
fi
{{ end -}}

[init]
	defaultBranch = main

[core]
	autocrlf = input

[fetch]
	prune = true

[push]
	autoSetupRemote = true

{{ if eq .profile "macbook" -}}
# Signing needs 1Password approval dialogs — a GUI luxury the nodes lack
[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgsign = true
{{ end -}}

{{ if eq .profile "work-macbook" -}}
# Signing needs 1Password approval dialogs — a GUI luxury the nodes lack
[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgsign = true
{{ end -}}

[url "git@github.com:"]
	insteadOf = https://github.com/

[alias]
	co = checkout
	nb = checkout -b 
	cp = cherry-pick
	br = branch
	st = status -sb
	lg = log --oneline --graph --decorate
	last = log -1 --stat
	amend = commit --amend --no-edit
	unstage = restore --staged
	undo = reset --soft HEAD~1
	pushf = push --force-with-lease
	main = !git switch main && git pull --prune
	sweep = !git fetch --prune && git branch -vv | awk '/: gone]/ {print $1}' | xargs git branch -D
	catchup = !git fetch origin && git merge origin/main
	aliases = config --get-regexp ^alias\\.
  amendf = !git amend && git pushf
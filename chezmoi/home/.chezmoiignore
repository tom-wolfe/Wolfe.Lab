{{ if eq .chezmoi.os "linux" -}}
# macOS-only files and scripts — the Pi (Linux) gets none of these. Its
# equivalents (apt packages, systemd units, a Linux Beszel agent, a Linux
# job bridge) arrive as their own slices. Until then this keeps `apply` from
# installing Homebrew or running `defaults` on Debian. Script names here are
# the run_ attributes stripped, matching the install-packages.sh line above.
.Brewfile
Library
Library/**
Docker
Docker/**
.docker-headless
.docker-headless/**
.local/bin/lab-job
.config/beszel
.config/beszel/**
# macOS-tuned dotfiles: zsh files carrying Homebrew paths, a Terminal.app
# profile, and an nvm wrapper for launchd. The Pi's shell env and node
# arrive as their own Linux slices.
.zshrc
.zprofile
.config/terminal
.config/terminal/**
.local/bin/nvm-run
.chezmoiscripts/install-packages.sh
.chezmoiscripts/install-homebrew.sh
.chezmoiscripts/configure-macos.sh
.chezmoiscripts/configure-terminal.sh
.chezmoiscripts/install-dotnet-tools.sh
.chezmoiscripts/install-node.sh
{{ end -}}
{{ if or .interactive (ne .chezmoi.os "linux") -}}
# The Actions runner is for Linux server nodes only.
.config/forgejo-runner
.config/forgejo-runner/**
.config/systemd
.config/systemd/**
.chezmoiscripts/forgejo-runner.sh
{{ end -}}

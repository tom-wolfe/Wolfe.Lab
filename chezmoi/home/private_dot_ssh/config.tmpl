Host macmini
  HostName macmini.local
  User tomwolfe

{{ if .server -}}
# Headless git: use the repo deploy key, never the 1Password UI agent.
Host github.com
  IdentityAgent none
  IdentityFile ~/.ssh/github_deploy
  IdentitiesOnly yes

{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
# The 1Password SSH agent lives behind a macOS GUI; a Linux server has no
# such socket and uses the deploy key above for github, defaults elsewhere.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end -}}

Host macmini
  HostName macmini.local
  User tomwolfe

{{ if eq .profile "macbook" -}}
# The 1Password SSH agent/
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end -}}

{{ if eq .profile "work-macbook" -}}
# The 1Password SSH agent.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end -}}

{{ if eq .profile "macmini-node" -}}
# Headless git.
Host github.com
  IdentityAgent none
  IdentityFile ~/.ssh/github_deploy
  IdentitiesOnly yes

# The 1Password SSH agent for everything else.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end -}}

{{ if eq .profile "pi-node" -}}
# Headless git.
Host github.com
  IdentityAgent none
  IdentityFile ~/.ssh/github_deploy
  IdentitiesOnly yes

# Forgejo is the chezmoi source remote, and there is no 1Password agent
# here, so reach it with its own read-only deploy key.
Host git.twolfe.dev
  IdentityFile ~/.ssh/forgejo_deploy
  IdentitiesOnly yes

# Linux nodes write their restic snapshots to the mini over SFTP, 
# with a key the mini's authorized_keys restricts to sftp-server.
Host macmini.tailf823b8.ts.net
  User tomwolfe
  IdentityFile ~/.ssh/restic
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
{{ end -}}

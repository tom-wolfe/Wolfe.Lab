Host macmini
  HostName macmini.local
  User tomwolfe

{{ if .server -}}
# Headless git: use a deploy key, never the 1Password UI agent.
Host github.com
  IdentityAgent none
  IdentityFile ~/.ssh/github_deploy
  IdentitiesOnly yes
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
# Forgejo hosts chezmoi, so 
Host git.twolfe.dev
  IdentityFile ~/.ssh/forgejo_deploy
  IdentitiesOnly yes
{{ end -}}

{{ if and .server (eq .chezmoi.os "linux") -}}
# Linux nodes write their restic snapshots to the mini over SFTP, 
# with a key the mini's authorized_keys restricts to sftp-server.
Host macmini.tailf823b8.ts.net
  User tomwolfe
  IdentityFile ~/.ssh/restic
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# Use the 1Password SSH by default on all Mac devices.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end -}}

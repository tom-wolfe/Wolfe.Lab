# Materialized ONCE from 1Password by chezmoi — the vault is the origin,
# this file is a cache. `create_` semantics: written only when MISSING,
# template never evaluated otherwise, so `op` (and the internet) are a
# bootstrap dependency, not a tick dependency. All reads resolve before
# the file exists at all — a failed read aborts the apply with nothing
# written, so no empty husk can satisfy the exists-check.
# Rotation: delete this file and `chezmoi apply`.
KESTRA_DB_PASSWORD={{ onepasswordRead "op://Wolfe.Lab/kestra-postgres/password" }}
KESTRA_BASIC_AUTH_PASSWORD={{ onepasswordRead "op://Wolfe.Lab/kestra-admin/password" }}
# Exactly 32 chars — kestra.encryption.secret-key requires it.
KESTRA_ENCRYPTION_KEY={{ onepasswordRead "op://Wolfe.Lab/kestra-encryption-key/credential" }}
# OSS secrets convention: SECRET_<NAME>, base64-encoded, read in flows as
# secret('LAB_SSH_KEY'). The printf preserves the trailing newline the old
# bootstrap script fed to base64 — Kestra's SSH parser wants it, and the
# encoding must stay byte-identical.
SECRET_LAB_SSH_KEY={{ printf "%s\n" (onepasswordRead "op://Wolfe.Lab/kestra-job-bridge/private key?ssh-format=openssh") | b64enc }}
# Pushover — the lab's one notification transport (system/alert-failed).
# `token` is the Pushover APPLICATION token, `user` the user key; both are
# plain strings, base64'd only because that's the SECRET_* convention.
SECRET_PUSHOVER_TOKEN={{ onepasswordRead "op://Wolfe.Lab/pushover/credential" | b64enc }}
SECRET_PUSHOVER_USER={{ onepasswordRead "op://Wolfe.Lab/pushover/username" | b64enc }}
# The dead man's switch. PROJECT-wide ping key, not a per-check URL: the
# flow composes https://hc-ping.com/<key>/<slug>, so every future check
# reuses this one secret and none of them survive in a vault item that has
# to be re-copied when a check is recreated. Checks are declared in
# chezmoi/tofu/. healthchecks.io -> Project Settings -> Ping Key.
SECRET_HEALTHCHECKS_PING_KEY={{ onepasswordRead "op://Wolfe.Lab/healthchecks-ping-key/credential" | b64enc }}

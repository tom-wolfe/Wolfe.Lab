#!/bin/bash
# Null credential helper for headless sessions — named by `credsStore` in
# ../private_config.json, found via the PATH lab-job exports. Speaks the
# docker-credential-helpers protocol but never touches the keychain: every
# lookup answers "not found", so registry access proceeds anonymously.
#
# WHY: with no credsStore at all, the Docker CLI's platform DEFAULT on
# macOS is osxkeychain (any time that helper binary is on PATH — and
# Docker Desktop puts it there), and in SSH sessions the login keychain is
# locked, so pulls of not-yet-cached images and every buildx build die
# with "keychain cannot be accessed". The lab only ever pulls public
# images headless; anonymous is not a downgrade, it's the intent.
#
# The `get` message is a protocol sentinel (ErrCredentialsNotFound) — the
# CLI string-matches it. Don't reword it.
case "${1:-}" in
  get)  echo "credentials not found in native keychain"; exit 1 ;;
  list) echo "{}" ;;
  store|erase) exit 0 ;;
  *) exit 1 ;;
esac

{{- /* Registration for one runner — the file `forgejo-runner register` would
       have written, rendered from the vault instead. Callers are create_
       files: written only when MISSING, so `op` is a bootstrap dependency,
       not a tick one. Args: name (the registered runner name, also the
       vault item suffix), labels (list), address (optional override).

       The secret is the 40-hex string forgejo/scripts/register-runner.sh
       registered server-side. Forgejo derives the runner's UUID from it as
       gouuid.FromBytes(secret[:16]) — the first sixteen CHARACTERS as raw
       bytes — so the same arithmetic here yields the same UUID (verified:
       7c31591e8b67225a... -> 37633331-3539-3165-3862-363732323561).
       Rotation: register a new secret, delete the target, `chezmoi apply`. */ -}}
{{- $secret := onepasswordRead (printf "op://Wolfe.Lab/forgejo-runner-%s/credential" .name) | trim -}}
{{- $hex := hexEncode (substr 0 16 $secret) -}}
{{- $uuid := printf "%s-%s-%s-%s-%s" (substr 0 8 $hex) (substr 8 12 $hex) (substr 12 16 $hex) (substr 16 20 $hex) (substr 20 32 $hex) -}}
{{- /* Instance address = Forgejo's ROOT_URL from the slice's own compose
       file (the filesystem is the stack reference — as forgejo/tofu/webhook.tf). */ -}}
{{- $compose := include "../../forgejo/compose.yaml" | fromYaml -}}
{{- $address := $compose.services.server.environment.FORGEJO__server__ROOT_URL | trimSuffix "/" -}}
{{- /* …unless the caller overrides it: the mini runs Forgejo, and its own
       runner reaches it over loopback so CD there depends on no name. */ -}}
{{- if .address }}{{ $address = .address }}{{ end -}}
{
  "name": {{ .name | quote }},
  "uuid": {{ $uuid | quote }},
  "token": {{ $secret | quote }},
  "address": {{ $address | quote }},
  "labels": [{{ range $i, $l := .labels }}{{ if $i }}, {{ end }}{{ $l | quote }}{{ end }}]
}

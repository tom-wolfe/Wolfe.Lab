# The node's containerized Actions runner — jobs run in containers on the
# node's Docker, the runner itself as this user (docker group). Restarted on
# config change by forgejo-runner-docker.path.
[Unit]
Description=Forgejo Actions runner (containerized jobs)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/forgejo-runner daemon --config %h/.config/forgejo-runner-docker/config.yaml
WorkingDirectory=%h/.config/forgejo-runner-docker
Restart=always
RestartSec=5s
# Let running jobs finish on stop (runner.shutdown_timeout is 10m).
TimeoutStopSec=15m

[Install]
WantedBy=default.target

# Restart the agent when its env file or unit changes — the agent reads its
# env at start only. chezmoi writes files; systemd notices.
[Unit]
Description=Watch the Beszel agent's env and unit for changes

[Path]
PathChanged=%h/.config/beszel/beszel-agent.env
PathChanged=%h/.config/systemd/user/beszel-agent.service
Unit=restart@beszel-agent.service

[Install]
WantedBy=default.target

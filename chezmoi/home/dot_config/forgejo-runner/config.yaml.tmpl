{{- /* The HOST runner: one job at a time (deploys mutate node state; a tick
       that overlaps itself queues), the bootstrap env, no cache. */ -}}
{{- template "forgejo-runner/config.yaml" (dict
      "home" .chezmoi.homeDir
      "dir" "forgejo-runner"
      "capacity" 1
      "host" true
      "labels" (list (printf "%s:host" .chezmoi.hostname))
      "cache" false) -}}

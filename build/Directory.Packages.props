    <PackageVersion Include="Ritten.Forgejo" Version="0.16.1" />
    <PackageVersion Include="Ritten.Git" Version="0.16.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lab</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfe.Lab.Build.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="Ritten.CommandLine" />
    <PackageReference Include="Ritten.Core" />
    <PackageReference Include="Ritten.Docker" />
    <PackageReference Include="Ritten.DotNet" />
    <PackageReference Include="Ritten.Forgejo" />
    <PackageReference Include="Ritten.Git" />
    <PackageReference Include="Ritten.NuGet" />
    <PackageReference Include="Ritten.OnePassword" />
    <PackageReference Include="Ritten.OpenTofu" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Vogen" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Clients\Agents\Systemd\systemd.service.sbn" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Ritten.Commands" />
    <Using Include="Ritten.Contracts" />
    <Using Include="Ritten.Contracts.FileSystem" />
    <Using Include="Ritten.Engine" />
    <Using Include="Ritten.Engine.Workflows" />
    <Using Include="Ritten.Reporting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

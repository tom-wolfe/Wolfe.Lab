<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lab</ToolCommandName>
    <PackageOutputPath>../../dist</PackageOutputPath>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfe.Lab.Build.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Ritten.CommandLine" />
    <PackageReference Include="Ritten.Core" />
    <PackageReference Include="Ritten.Git" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Ritten.Commands" />
    <Using Include="Ritten.Contracts" />
    <Using Include="Ritten.Contracts.FileSystem" />
    <Using Include="Ritten.Engine" />
    <Using Include="Ritten.Engine.Workflows" />
    <Using Include="Ritten.Reporting" />
  </ItemGroup>

</Project>

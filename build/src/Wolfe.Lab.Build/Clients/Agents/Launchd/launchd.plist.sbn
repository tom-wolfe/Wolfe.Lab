<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
 Generated by `lab deploy` — edits here are overwritten.
 program: {{ Program }}
 stamped: {{ Stamped }}
-->
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>{{ Label }}</string>
		<key>ProgramArguments</key>
		<array>
{{- for Argument in Arguments }}
			<string>{{ Argument }}</string>
{{- end }}
		</array>
{{- if WorkingDirectory }}
		<key>WorkingDirectory</key>
		<string>{{ WorkingDirectory }}</string>
{{- end }}
{{- if HasEnvironment }}
		<key>EnvironmentVariables</key>
		<dict>
{{- for Variable in Environment }}
			<key>{{ Variable.Key }}</key>
			<string>{{ Variable.Value }}</string>
{{- end }}
		</dict>
{{- end }}
		<key>RunAtLoad</key>
		<true/>
		<key>KeepAlive</key>
{{- if KeepAlive }}
		<true/>
{{- else }}
		<false/>
{{- end }}
{{- if ExitTimeout }}
		<key>ExitTimeOut</key>
		<integer>{{ ExitTimeout }}</integer>
{{- end }}
{{- if Log }}
		<key>StandardOutPath</key>
		<string>{{ Log }}</string>
		<key>StandardErrorPath</key>
		<string>{{ Log }}</string>
{{- end }}
	</dict>
</plist>

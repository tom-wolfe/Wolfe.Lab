# rclone remote "garage:" via env vars only — no rclone.conf, no secrets on disk.
# Usage: op run --env-file=compose/garage/rclone.env -- rclone ls garage:tofu-state
RCLONE_CONFIG_GARAGE_TYPE=s3
RCLONE_CONFIG_GARAGE_PROVIDER=Other
RCLONE_CONFIG_GARAGE_ENDPOINT=http://macmini.local:3900
RCLONE_CONFIG_GARAGE_REGION=garage
RCLONE_CONFIG_GARAGE_FORCE_PATH_STYLE=true
RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID="op://Personal/Garage tofu-state-key/username"
RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY="op://Personal/Garage tofu-state-key/credential"

{
  "workflow": "immich",
  "volumes": [
    "/Volumes/Data2"
  ],
  "server": {
    "url": "http://immich-server:2283",
    "apiKey": "op://Wolfe.Lab/immich-api-key/credential"
  },
  "takeout": {
    "path": "/Volumes/Data2/photos/google"
  },
  "import": {
    "concurrency": 4
  },
  "backup": {
    "paths": [
      "/Volumes/Data2/immich"
    ],
    "excludes": [
      "/Volumes/Data2/immich/thumbs",
      "/Volumes/Data2/immich/encoded-video"
    ],
    "image": "immich-server"
  }
}

// The mini's collector (monitoring/alloy/README.md): the node's own, and the
// gateway — the one collector that writes to the stores, on their loopback
// ports (monitoring/grafana/README.md). Every other node's forwards here
// (forwarder.alloy), over the tailnet, never through caddy: a broken front
// door must not hide the evidence of its own failure.

import.file "node" {
	filename = sys.env("LAB_ROOT") + "/alloy/node.alloy"
}

// ── The mini itself ────────────────────────────────────────────────────────

node.collect "mini" {
	otlp_to    = [otelcol.processor.batch.stores.input]
	logs_to    = [loki.write.stores.receiver]
	metrics_to = [prometheus.remote_write.stores.receiver]
}

// ── What the other nodes forward ───────────────────────────────────────────
// On every interface, like the mini's other services; the tailnet policy is
// what lets a node reach them. Passed through as it arrived: each node
// labelled its own where it read it (node.alloy), and a label set here would
// only ever be the mini's.

otelcol.receiver.otlp "nodes" {
	grpc {
		endpoint = "0.0.0.0:4417"
	}

	output {
		metrics = [otelcol.processor.batch.stores.input]
		logs    = [otelcol.processor.batch.stores.input]
		traces  = [otelcol.processor.batch.stores.input]
	}
}

loki.source.api "nodes" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 4418
	}

	// When it happened, not when it got here: a node catching up after an
	// outage sends what it buffered.
	use_incoming_timestamp = true
	forward_to             = [loki.write.stores.receiver]
}

prometheus.receive_http "nodes" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 4419
	}

	forward_to = [prometheus.remote_write.stores.receiver]
}

// ── The stores, on the mini's loopback ─────────────────────────────────────

otelcol.processor.batch "stores" {
	output {
		metrics = [otelcol.exporter.otlphttp.prometheus.input]
		logs    = [otelcol.exporter.otlphttp.loki.input]
		traces  = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "127.0.0.1:14317"

		tls {
			insecure = true
		}
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://127.0.0.1:3100/otlp"
	}
}

otelcol.exporter.otlphttp "prometheus" {
	client {
		endpoint = "http://127.0.0.1:9090/api/v1/otlp"
	}
}

loki.write "stores" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}

prometheus.remote_write "stores" {
	endpoint {
		url = "http://127.0.0.1:9090/api/v1/write"
	}
}

// The collector on every node (monitoring/alloy/README.md). This one is the
// mini's: the one that writes to the stores, on their loopback ports
// (monitoring/grafana/README.md). The node's identity comes from the agent's
// environment (ritten.json), so one config serves any node it is placed on.

logging {
	level  = "info"
	format = "logfmt"
}

// ── OTLP from applications ─────────────────────────────────────────────────
// On loopback: a container reaches it at host.docker.internal, which Docker
// Desktop forwards to the host's loopback. Other nodes forwarding here is
// ROADMAP.md #11 step 3, and opens a tailnet address then.

otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "127.0.0.1:4317"
	}

	http {
		endpoint = "127.0.0.1:4318"
	}

	output {
		metrics = [otelcol.processor.transform.node.input]
		logs    = [otelcol.processor.transform.node.input]
		traces  = [otelcol.processor.transform.node.input]
	}
}

// The lab's label schema (ROADMAP.md #11): the node an application runs on,
// and its role, set where the application did not say — never over what it
// sent. OTTL, in the resource context; the node's values come from the agent.
otelcol.processor.transform "node" {
	error_mode = "ignore"

	trace_statements {
		context    = "resource"
		statements = [
			string.format("set(attributes[\"host.name\"], %q) where attributes[\"host.name\"] == nil", sys.env("LAB_HOST")),
			string.format("set(attributes[\"lab.role\"], %q) where attributes[\"lab.role\"] == nil", sys.env("LAB_ROLE")),
		]
	}

	metric_statements {
		context    = "resource"
		statements = [
			string.format("set(attributes[\"host.name\"], %q) where attributes[\"host.name\"] == nil", sys.env("LAB_HOST")),
			string.format("set(attributes[\"lab.role\"], %q) where attributes[\"lab.role\"] == nil", sys.env("LAB_ROLE")),
		]
	}

	log_statements {
		context    = "resource"
		statements = [
			string.format("set(attributes[\"host.name\"], %q) where attributes[\"host.name\"] == nil", sys.env("LAB_HOST")),
			string.format("set(attributes[\"lab.role\"], %q) where attributes[\"lab.role\"] == nil", sys.env("LAB_ROLE")),
		]
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
		logs    = [otelcol.processor.batch.default.input]
		traces  = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.otlphttp.prometheus.input]
		logs    = [otelcol.exporter.otlphttp.loki.input]
		traces  = [otelcol.exporter.otlp.tempo.input]
	}
}

// ── Container logs ─────────────────────────────────────────────────────────
// Every container on the node, read through the Docker socket (on a Mac the
// logs live inside the VM, out of reach as files). Each stream is named for
// its container and carries the labels the deploy put on it (platform/lab/README.md):
// the node's own, and where in the lab the container lives. A container that
// sends its own logs over OTLP says so with `lab.logs: otlp`, and is left out
// here rather than stored twice.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_lab_logs"]
		regex         = "otlp"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_lab_area"]
		target_label  = "lab_area"
	}

	rule {
		source_labels = ["__meta_docker_container_label_lab_service"]
		target_label  = "lab_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_lab_component"]
		target_label  = "lab_component"
	}

	rule {
		target_label = "host_name"
		replacement  = sys.env("LAB_HOST")
	}

	rule {
		target_label = "lab_role"
		replacement  = sys.env("LAB_ROLE")
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.stores.receiver]
}

loki.write "stores" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}

// ── The stores, on the mini's loopback ─────────────────────────────────────

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "127.0.0.1:14317"

		tls {
			insecure = true
		}
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://127.0.0.1:3100/otlp"
	}
}

otelcol.exporter.otlphttp "prometheus" {
	client {
		endpoint = "http://127.0.0.1:9090/api/v1/otlp"
	}
}

// ── Alloy's own health ─────────────────────────────────────────────────────
// Its pipelines' throughput and failures, under the same schema as
// everything it carries.

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
	targets         = prometheus.exporter.self.alloy.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.node.receiver]
}

prometheus.relabel "node" {
	rule {
		target_label = "service_name"
		replacement  = "alloy"
	}

	rule {
		target_label = "host_name"
		replacement  = sys.env("LAB_HOST")
	}

	rule {
		target_label = "lab_role"
		replacement  = sys.env("LAB_ROLE")
	}

	forward_to = [prometheus.remote_write.stores.receiver]
}

prometheus.remote_write "stores" {
	endpoint {
		url = "http://127.0.0.1:9090/api/v1/write"
	}
}

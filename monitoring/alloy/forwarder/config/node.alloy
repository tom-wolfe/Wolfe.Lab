// What every node's collector gathers from the node itself
// (monitoring/alloy/README.md), as one component its root config places:
// forwarder.alloy, on every node. The root says where it goes; this labels it
// with the node, once, here — so the gateway passes what each node sends
// through as it arrived. The node's identity
// comes from the agent's environment: LAB_HOST and LAB_ROLE, which its node
// sets for every agent.

declare "collect" {
	argument "otlp_to" {
		comment = "Where applications' OTLP goes, once labelled: consumers of every signal."
	}

	argument "logs_to" {
		comment = "Where the node's log streams go, once labelled."
	}

	argument "metrics_to" {
		comment = "Where scraped metrics go, once labelled: the collector's own and its containers'."
	}

	// ── OTLP from applications ───────────────────────────────────────────
	// On loopback: a container reaches it at host.docker.internal, which
	// Docker Desktop forwards to the host's loopback.

	otelcol.receiver.otlp "local" {
		grpc {
			endpoint = "127.0.0.1:4317"
		}

		http {
			endpoint = "127.0.0.1:4318"
		}

		output {
			metrics = [otelcol.processor.transform.node.input]
			logs    = [otelcol.processor.transform.node.input]
			traces  = [otelcol.processor.transform.node.input]
		}
	}

	// The lab's label schema (ROADMAP.md #11): the node an application runs
	// on, and its role, set where the application did not say — never over
	// what it sent. OTTL, in the resource context.
	otelcol.processor.transform "node" {
		error_mode = "ignore"

		trace_statements {
			context    = "resource"
			statements = [
				string.format("set(attributes[\"host.name\"], %q) where attributes[\"host.name\"] == nil", sys.env("LAB_HOST")),
				string.format("set(attributes[\"lab.role\"], %q) where attributes[\"lab.role\"] == nil", sys.env("LAB_ROLE")),
			]
		}

		metric_statements {
			context    = "resource"
			statements = [
				string.format("set(attributes[\"host.name\"], %q) where attributes[\"host.name\"] == nil", sys.env("LAB_HOST")),
				string.format("set(attributes[\"lab.role\"], %q) where attributes[\"lab.role\"] == nil", sys.env("LAB_ROLE")),
			]
		}

		log_statements {
			context    = "resource"
			statements = [
				string.format("set(attributes[\"host.name\"], %q) where attributes[\"host.name\"] == nil", sys.env("LAB_HOST")),
				string.format("set(attributes[\"lab.role\"], %q) where attributes[\"lab.role\"] == nil", sys.env("LAB_ROLE")),
			]
		}

		output {
			metrics = argument.otlp_to.value
			logs    = argument.otlp_to.value
			traces  = argument.otlp_to.value
		}
	}

	// ── Container logs ───────────────────────────────────────────────────
	// Every container on the node, read through the Docker socket (on a Mac
	// the logs live inside the VM, out of reach as files). Each stream is
	// named for its container and carries every `lab.*` label the deploy put
	// on it — where in the lab the container lives (platform/lab/README.md) —
	// so a new one needs nothing here. A container that sends its own logs
	// over OTLP says so with `lab.logs: otlp`, and is left out rather than
	// stored twice. The socket is the standard one unless the agent names
	// another (DOCKER_HOST): Docker Desktop offers it only when allowed to.

	discovery.docker "containers" {
		host = coalesce(sys.env("DOCKER_HOST"), "unix:///var/run/docker.sock")
	}

	discovery.relabel "containers" {
		targets = discovery.docker.containers.targets

		rule {
			source_labels = ["__meta_docker_container_label_lab_logs"]
			regex         = "otlp"
			action        = "drop"
		}

		rule {
			source_labels = ["__meta_docker_container_name"]
			regex         = "/(.*)"
			target_label  = "service_name"
		}

		rule {
			action      = "labelmap"
			regex       = "__meta_docker_container_label_(lab_.+)"
			replacement = "$1"
		}
	}

	loki.source.docker "containers" {
		host       = coalesce(sys.env("DOCKER_HOST"), "unix:///var/run/docker.sock")
		targets    = discovery.relabel.containers.output
		forward_to = [loki.relabel.node.receiver]
	}

	// ── Declared metrics ─────────────────────────────────────────────────
	// The endpoints a deploy declares in ${LAB_ROOT}/.metrics, a file per
	// component, as it declares log files in .logs: each target names its
	// address on the node's loopback, its path (__metrics_path__) and where it
	// lives (platform/lab/README.md, "Declarations"). Several endpoints of one
	// container, a port of the component's choosing, and a host process's
	// metrics are all just entries here.

	discovery.file "metrics" {
		files = [sys.env("LAB_ROOT") + "/.metrics/*.json"]
	}

	prometheus.scrape "declared" {
		targets         = discovery.file.metrics.targets
		scrape_interval = "30s"
		forward_to      = [prometheus.relabel.node.receiver]
	}

	// ── Host-process logs, as files ──────────────────────────────────────
	// The files the node's own processes log to, as whatever runs them
	// declares them in ${LAB_ROOT}/.logs: an agent deploy, for its agents, and
	// chezmoi, for the runner (platform/lab/README.md, "Agents"). Each target
	// names its stream and where it lives. Read from where a file ends on
	// first sight: a launchd log is appended to for as long as the agent has
	// existed, and that history is a burst, not a record. A node whose agents
	// log to the journal declares none, and this finds nothing.

	discovery.file "logs" {
		files = [sys.env("LAB_ROOT") + "/.logs/*.json"]
	}

	loki.source.file "logs" {
		targets       = discovery.file.logs.targets
		tail_from_end = true
		forward_to    = [loki.relabel.node.receiver]
	}

	// ── Host-process logs, from the journal ──────────────────────────────
	// A Linux node's: its system's and its agents' alike, each stream named
	// for its unit — a user unit's own name, not its manager's — or, with
	// none, for what it logged as (the kernel). A lab agent's unit carries the
	// lab's prefix (dev.twolfe.alloy.service), and its stream is named as a
	// Mac's file target names it: for the agent (alloy). On a Mac this is a
	// no-op.

	loki.relabel "journal" {
		forward_to = []

		rule {
			source_labels = ["__journal_syslog_identifier"]
			target_label  = "service_name"
		}

		rule {
			source_labels = ["__journal__systemd_unit"]
			regex         = "(.+)\\.service"
			target_label  = "service_name"
		}

		rule {
			source_labels = ["__journal__systemd_user_unit"]
			regex         = "(?:dev\\.twolfe\\.)?(.+)\\.service"
			target_label  = "service_name"
		}
	}

	loki.source.journal "node" {
		relabel_rules = loki.relabel.journal.rules
		forward_to    = [loki.relabel.node.receiver]
	}

	// Every stream the node reads, labelled with the node that read it.
	loki.relabel "node" {
		forward_to = argument.logs_to.value

		rule {
			target_label = "host_name"
			replacement  = sys.env("LAB_HOST")
		}

		rule {
			target_label = "lab_role"
			replacement  = sys.env("LAB_ROLE")
		}
	}

	// ── The collector's own health ───────────────────────────────────────
	// Its pipelines' throughput and failures, under the same schema as
	// everything it carries.

	prometheus.exporter.self "alloy" { }

	prometheus.scrape "alloy" {
		targets         = prometheus.exporter.self.alloy.targets
		scrape_interval = "30s"
		forward_to      = [prometheus.relabel.alloy.receiver]
	}

	prometheus.relabel "alloy" {
		forward_to = [prometheus.relabel.node.receiver]

		rule {
			target_label = "service_name"
			replacement  = "alloy"
		}
	}

	// Every metric the node scrapes, labelled with the node that scraped it.
	prometheus.relabel "node" {
		forward_to = argument.metrics_to.value

		rule {
			target_label = "host_name"
			replacement  = sys.env("LAB_HOST")
		}

		rule {
			target_label = "lab_role"
			replacement  = sys.env("LAB_ROLE")
		}
	}
}

{
  "uid": "lab-nodes",
  "title": "Nodes",
  "description": "The lab's machines and their containers, from each node's collector (monitoring/alloy).",
  "tags": [
    "lab"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, host_name)",
          "refId": "host"
        },
        "definition": "label_values(node_uname_info, host_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Nodes",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU busy",
      "description": "Every core's busy time, as the alert reads it.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg by (host_name) (rate(node_cpu_seconds_total{mode=\"idle\", host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "description": "On a Mac what Activity Monitor calls used; on Linux what is not available.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) ((node_memory_internal_bytes{host_name=~\"$host\"} - node_memory_purgeable_bytes{host_name=~\"$host\"} + node_memory_wired_bytes{host_name=~\"$host\"} + node_memory_compressed_bytes{host_name=~\"$host\"}) / node_memory_total_bytes{host_name=~\"$host\"} or 1 - node_memory_MemAvailable_bytes{host_name=~\"$host\"} / node_memory_MemTotal_bytes{host_name=~\"$host\"})",
          "legendFormat": "{{host_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk used",
      "description": "Every writable filesystem the node has: a Mac's data volume and its drives, Linux's mounts.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name, mountpoint) ((1 - node_filesystem_avail_bytes{host_name=~\"$host\"} / node_filesystem_size_bytes{host_name=~\"$host\"}) unless on (host_name, mountpoint) (node_filesystem_readonly{host_name=~\"$host\"} == 1))",
          "legendFormat": "{{host_name}} {{mountpoint}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load",
      "description": "The one-minute load average, per core.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) (node_load1{host_name=~\"$host\"}) / count by (host_name) (node_cpu_seconds_total{mode=\"idle\", host_name=~\"$host\"})",
          "legendFormat": "{{host_name}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network",
      "description": "Bytes a second through the node's real interfaces; sent below the line.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host_name) (rate(node_network_receive_bytes_total{host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} received",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-sum by (host_name) (rate(node_network_transmit_bytes_total{host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} sent",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Temperature",
      "description": "Where the node has sensors the exporter reads: Linux's, not a Mac's.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name, chip, sensor) (node_hwmon_temp_celsius{host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} {{chip}} {{sensor}}",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Containers",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Container CPU",
      "description": "Cores each container uses.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host_name, service_name) (rate(container_cpu_usage_seconds_total{service_name!=\"\", host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} ({{host_name}})",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container memory",
      "description": "Each container's working set, what its memory limit is held to.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host_name, service_name) (container_memory_working_set_bytes{service_name!=\"\", host_name=~\"$host\"})",
          "legendFormat": "{{service_name}} ({{host_name}})",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container network",
      "description": "Bytes a second each container receives; sent below the line.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host_name, service_name) (rate(container_network_receive_bytes_total{service_name!=\"\", host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} received",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-sum by (host_name, service_name) (rate(container_network_transmit_bytes_total{service_name!=\"\", host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} sent",
          "range": true
        }
      ]
    }
  ]
}
